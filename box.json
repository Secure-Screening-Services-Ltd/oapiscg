{
  "compression": "GZ",
  "files": [
    "LICENSE"
  ],
  "finder": [
    {
      "exclude": [
        "tests"
      ],
      "in": "src"
    },
    {
      "name": "{\\.(php|bash|fish|zsh)}",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor"
    }
  ],
  "git-tag": "git_tag",
  "main": "bin/oapiscg",
  "intercept": true,
  "output": "build/oapiscg.phar"
}
